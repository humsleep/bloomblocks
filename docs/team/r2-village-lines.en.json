 "triggers": {
  "move_in": "First talk after this resident moved in (move-in day). Shown once each, in order.",
  "greet": "First talk of a visit. cond.time = dawn 05-09 | day 09-17 | dusk 17-21 | night 21-05 (device local time).",
  "puzzle.solved": "Player lit >=1 board today and has not heard a puzzle line today.",
  "puzzle.hard": "Today: a deduce-track board, or Today's puzzle, solved with no hints (the ✨ flag).",
  "return": "First village visit after a gap of >=3 calendar days since the last village visit. Never states the gap.",
  "season": "cond.season from the real calendar + hemisphere (device region; Settings override). Max 1 per resident per day.",
  "event.first_snow": "First village visit on/after Dec 1 (N) or Jun 1 (S), once per year; 1.0 approximates snow by date.",
  "request.ask": "Opens this resident's single open request (cond.category = furniture category). No deadline.",
  "request.again": "Same open request, re-said gently. Only if >=3 days since the ask.",
  "request.visit": "Request fulfilled: resident sits in the player's cabin next to the placed item. Tap line.",
  "letter.move_in": "Mailbox letter with the resident's signature furniture on move-in.",
  "letter.gift": "Mailbox letter when the lantern-drop jar fills (one resident per jar, round-robin over residents).",
  "letter.thanks": "Mailbox letter the day after a request was fulfilled (+ a furniture item of a liked category).",
  "letter.return": "Wick only. Mailbox letter on the first visit after a gap of >=7 days.",
  "gift.tag": "Paper tag on a second+ jar gift the same day (letters are max 1/day). <=30 chars.",
  "friend.level": "Once, when friendship reaches cond.level (3 or 5).",
  "chat": "Small talk; cond.requires = residents who must live here. Lowest priority.",
  "tap.again": "Player taps the same resident again during the same visit.",
  "host": "Wick as village host (village, market, cabin, mailbox). Only when there is news; else Wick uses normal lines."
 },
